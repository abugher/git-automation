#!/bin/bash


# Find location of self.
self_path="$(readlink -f "${0}")"
cd "${self_path%/*}/.."
git_automation="${PWD}"
cd "${OLDPWD}"

# Find identity of self.
self_name="${0##*/}"

# Load libraries.
libs=(
  'vars'
  'projects'
  'git'
  'main'
)
if ! . "${git_automation}/lib/common.sh"; then
  echo "Failed to load common dependencies." >&2
  exit 1
fi

# Do git stuff.
main "${@}"
